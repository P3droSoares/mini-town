{
  "name": "mini-town-itabirito",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cidade 3D explorável de Itabirito-MG (módulo 1 de um jogo de simulação).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "fetch-osm": "tsx scripts/fetch-osm.ts",
    "fetch-assets": "tsx scripts/fetch-assets.ts",
    "generate-city": "tsx scripts/generate-city.ts",
    "docker:secrets": "node scripts/gen-secrets.mjs",
    "docker:up": "node scripts/gen-secrets.mjs && docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f --tail=100 server web",
    "docker:smoke": "node docker/smoke.mjs",
    "docker:backup": "docker compose exec backup pg-backup.sh once",
    "docker:restore": "bash docker/backup/restore.sh"
  },
  "dependencies": {
    "n8ao": "^1.10.3",
    "postprocessing": "^6.39.5",
    "three": "^0.170.0",
    "three-mesh-bvh": "^0.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.170.0",
    "happy-dom": "^20.14.5",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
