# Exemplo do .env da raiz (lido só pelo docker compose, no host; nenhum
# container monta este arquivo). Não preencha à mão:
#   node scripts/gen-secrets.mjs
# gera o .env com valores aleatórios (ou completa um .env antigo com as
# variáveis que faltam). O .env nunca é versionado.
APP_ORIGIN=https://localhost:8443
LOG_LEVEL=info

# Postgres: superusuário (só init/admin pelo socket local; recusado pela rede),
# dono das migrações (só o serviço migrate), app (API) e backup (só leitura).
# Senhas hex/URL-safe.
POSTGRES_DB=minitown
POSTGRES_PASSWORD=
MINITOWN_OWNER_PASSWORD=
MINITOWN_APP_PASSWORD=
MINITOWN_BACKUP_PASSWORD=

# chaves simétricas: base64 de 32 bytes cada, distintas (openssl rand -base64 32)
SESSION_KEY=
CSRF_KEY=
EMAIL_ENC_KEY=
EMAIL_HASH_KEY=
PASSWORD_PEPPER=
EMAIL_KEY_VERSION=1

# HSTS enviado pelo Caddy. Vazio = max-age=0 (dev em localhost: HSTS vale por
# host, não por porta). Produção, com domínio próprio:
# CADDY_HSTS=max-age=31536000; includeSubDomains
CADDY_HSTS=
