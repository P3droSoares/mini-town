# Exemplo de ambiente do server (copie para .env; .env nunca é versionado).
# Gere cada chave com: openssl rand -base64 32
NODE_ENV=development
# fora do Docker escute só localmente (o compose usa 0.0.0.0 na rede do proxy)
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
APP_ORIGIN=https://localhost:8443
# papel app (DML mínimo); sem sslmode na URL
DATABASE_URL=postgres://minitown_app:TROQUE@db:5432/minitown
# papel dono: SÓ no ambiente do `npm run migrate` (one-shot), nunca no do
# server (a credencial ficaria em /proc/<pid>/environ do processo da API;
# com NODE_ENV=production o server recusa subir com ela). Ex.:
#   MIGRATION_DATABASE_URL=postgres://minitown_owner:TROQUE@db:5432/minitown npm run migrate
# CA do Postgres: presente = TLS verify-full (obrigatório em produção)
PGSSLROOTCERT=
SESSION_KEY=
CSRF_KEY=
EMAIL_ENC_KEY=
EMAIL_HASH_KEY=
# pepper das senhas (obrigatório em produção); a versão vai gravada no hash
PASSWORD_PEPPER=
PASSWORD_PEPPER_VERSION=1
# rotação: peppers/chaves antigas continuam aceitos com o sufixo da versão
# PASSWORD_PEPPER_1=
# EMAIL_ENC_KEY_1=
EMAIL_KEY_VERSION=1
CITY_DATA_PATH=../public/data/itabirito.json
# X-Forwarded-For: 0 = ignorado (conexão direta). Atrás de proxy, 1 + o
# IP/CIDR do proxy em TRUSTED_PROXIES (obrigatório quando HOPS > 0)
TRUST_PROXY_HOPS=0
TRUSTED_PROXIES=
